# 复制为 .env.production，并替换为你自己的随机密码。
# 第一阶段请只使用 URL 安全字符：大小写字母和数字。
POSTGRES_PASSWORD=replace_with_a_long_random_password

APP_PORT=8088
DEEPSEEK_MODEL=deepseek-v4-flash
CHAT_CONTEXT_MESSAGE_LIMIT=50
AGENT_MAX_TOOL_ROUNDS=4
AGENT_MAX_TOOL_CALLS=6
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_EXTRACT_MAX_URLS=5
WEB_EXTRACT_MAX_CONTENT_LENGTH=20000
WEB_EXTRACT_TIMEOUT_SECONDS=45
DEEP_RESEARCH_TIMEOUT_SECONDS=180
DEEP_RESEARCH_POLL_INTERVAL_SECONDS=2
DEEP_RESEARCH_MAX_CONTENT_LENGTH=30000
OBJECT_STORAGE_ENDPOINT_URL=https://s3.us-west-000.backblazeb2.com
OBJECT_STORAGE_REGION=us-west-000
OBJECT_STORAGE_ACCESS_KEY_ID=replace_with_b2_key_id
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace_with_b2_application_key
OBJECT_STORAGE_BUCKET=replace_with_bucket_name
DOCUMENT_MAX_BYTES=26214400
DOCUMENT_CACHE_PATH=./document_cache
DOCUMENT_CACHE_MAX_BYTES=5368709120
WATCHTOWER_POLL_INTERVAL=300
